diff --git a/tests/agent/test_internal_context_boundary.py b/tests/agent/test_internal_context_boundary.py
new file mode 100644
index 0000000..f982181
--- /dev/null
+++ b/tests/agent/test_internal_context_boundary.py
+"""El contexto interno conserva su fila sin convertirse en palabras del usuario."""
+from copy import deepcopy
+from types import SimpleNamespace
+import logging
+import time
+
+from agent.agent_runtime_helpers import (
+    repair_message_sequence, drop_thinking_only_and_merge_users, sanitize_api_messages,
+)
+from agent.context_compressor import ContextCompressor, _build_verbatim_user_section
+from agent.message_metadata import is_internal_context_message
+
+
+def context_row():
+    return {'role': 'user', 'content': 'Referencia histórica interna',
+            'display_kind': 'internal_context',
+            'display_metadata': {'context_source': 'tests/tool-thread'}}
+
+
+def test_durable_provenance_not_content():
+    row = context_row()
+    assert is_internal_context_message(row)
+    for bad in ({'role': 'user', 'content': row['content']},
+                {**row, 'display_metadata': {}}, {**row, 'display_metadata': []},
+                {**row, 'role': 'assistant'}):
+        assert not is_internal_context_message(bad)
+
+
+def test_repair_preserves_both_sides_and_memory_sidecar():
+    rows = [{'role': 'user', 'content': 'Pregunta', 'api_content': 'Pregunta + memoria'},
+            context_row(), {'role': 'user', 'content': 'Continuación'}]
+    before = deepcopy(rows)
+    assert repair_message_sequence(None, rows) == 0
+    assert rows == before
+    compressor = ContextCompressor('offline', config_context_length=100000)
+    assert compressor._merge_adjacent_user_turns(rows) == before
+
+
+def test_context_is_not_human_quote():
+    row = context_row()
+    assert ContextCompressor._is_synthetic_compression_user_turn(row)
+    assert _build_verbatim_user_section([row]) == ''
+    assert 'Pregunta' in _build_verbatim_user_section([row, {'role': 'user', 'content': 'Pregunta'}])
+
+
+def test_send_merge_preserves_explicit_boundary():
+    rows = [{'role': 'user', 'content': 'Pregunta + memoria'},
+            {'role': 'user', 'content': context_row()['content']},
+            {'role': 'assistant', 'content': 'Respuesta'}]
+    before = deepcopy(rows)
+    out = drop_thinking_only_and_merge_users(
+        rows, internal_context_contents=frozenset({rows[1]['content']}))
+    assert out == before and rows == before
+    # El comportamiento previo sigue intacto cuando no hay procedencia interna.
+    assert len(drop_thinking_only_and_merge_users(rows)) == 2
+
+
+def test_full_request_assembly_keeps_separate_user_context(monkeypatch):
+    from agent.turn_request_assembly import assemble_api_request
+    from agent.message_sanitization import ReasoningReplayRoute
+    import agent.conversation_loop as loop
+
+    agent = SimpleNamespace(
+        _current_turn_timestamp=time.time(), ephemeral_system_prompt='',
+        _copy_reasoning_content_for_api=lambda *args: None,
+        _should_sanitize_tool_calls=lambda: False, prefill_messages=[],
+        _sanitize_api_messages=sanitize_api_messages,
+        _drop_thinking_only_and_merge_users=drop_thinking_only_and_merge_users,
+        api_mode='chat_completions', provider='custom', model='offline', base_url='http://localhost/v1',
+        tools=[], _use_prompt_caching=False, _usage_anchor=None,
+        context_compressor=SimpleNamespace(),
+        _reasoning_replay_route=lambda: ReasoningReplayRoute(False, None),
+        _needs_thinking_reasoning_pad=lambda: False,
+    )
+    monkeypatch.setattr(loop, '_apply_context_engine_selection', lambda agent, api, *args, **kwargs: api)
+    monkeypatch.setattr(loop, '_pressure_with_real_floor', lambda compressor, value: value)
+    monkeypatch.setattr(loop, '_midturn_request_pressure_tokens', lambda agent, messages, system, approx: approx)
+    rows = [{'role': 'user', 'content': 'Pregunta', 'api_content': 'Pregunta\n<memory-context>memoria</memory-context>'},
+            context_row(), {'role': 'assistant', 'content': 'Respuesta'},
+            {'role': 'user', 'content': 'Siguiente'}]
+    before = deepcopy(rows)
+    request = assemble_api_request(
+        agent, messages=rows, current_turn_user_idx=3, _ext_prefetch_cache='', _plugin_user_context='',
+        moa_config=None, active_system_prompt='', original_user_message='Siguiente',
+        pending_moa_prepared_request=None, request_logger=logging.getLogger('test'),
+    )
+    assert [m['role'] for m in request.api_messages] == ['user', 'user', 'assistant', 'user']
+    assert request.api_messages[0]['content'] == before[0]['api_content']
+    assert request.api_messages[1]['content'] == rows[1]['content']
+    assert request.api_messages[2]['content'] == 'Respuesta'
+    assert all(not any(k in m for k in ('display_kind', 'display_metadata')) for m in request.api_messages)
+    assert rows == before
